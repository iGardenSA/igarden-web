# ==========================================================================
# iGarden Web — Environment Variables
# انسخ هذا الملف إلى .env.local وعبّئ القيم
# ==========================================================================

# ----- الموقع -----
NEXT_PUBLIC_SITE_URL=https://igarden.sa
NEXT_PUBLIC_SHOP_URL=https://shop.igarden.sa

# ----- Supabase -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ----- التحليلات (PDPL-friendly — Plausible فقط) -----
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=igarden.sa

# ----- الإيميل (للنماذج) -----
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@igarden.sa
# مُرسِل إشعار الليدات (نطاق مُتحقَّق في Resend) — اختياري
LEAD_NOTIFY_FROM=iGarden Leads <leads@igarden.sa>

# ----- إشعار الليدات عبر تلغرام (اختياري — قناة مستقلّة عن البريد) -----
# البوت من @BotFather · chat_id من https://api.telegram.org/bot<TOKEN>/getUpdates بعد إرسال /start للبوت
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
